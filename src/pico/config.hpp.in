#pragma once

// Bitmask for modules
#define GATAS_LOG_TCPCLIENT      (1u << 0)
#ifndef GATAS_LOG_ACTIVE_MODULES
#define GATAS_LOG_ACTIVE_MODULES ( 0 )
#endif

// ***** Networking
// NO_SYS should have been set by pico_cyw43_arch_lwip_sys_freertos but somehow it's not added
#define NO_SYS 0
#define LWIP_HTTPD 1
#define LWIP_HTTPD_SSI 0
#define LWIP_HTTPD_CGI 0
#define LWIP_HTTPD_SUPPORT_POST 1
#define LWIP_HTTPD_FILE_EXTENSION 1
#define LWIP_HTTPD_CUSTOM_FILES 1

// Required for the PICO and FreeRTOS
#define TCPIP_THREAD_STACKSIZE 2048 // mDNS needs more stack
#define DEFAULT_THREAD_STACKSIZE 1024
#define DEFAULT_RAW_RECVMBOX_SIZE 8
#define DEFAULT_UDP_RECVMBOX_SIZE 8
#define DEFAULT_TCP_RECVMBOX_SIZE 8
#define TCPIP_MBOX_SIZE 8

#define LWIP_TIMEVAL_PRIVATE 0
#define LWIP_TCPIP_CORE_LOCKING_INPUT 1

// START: The following is needed to test mDns
#define LWIP_MDNS_RESPONDER 1
#define LWIP_IGMP 1
#define LWIP_NUM_NETIF_CLIENT_DATA 1
#define MDNS_RESP_USENETIF_EXTCALLBACK  1
// Increased to 8 t0 prevent sys_timeout: timeout != NULL, pool MEMP_SYS_TIMEOUT is empty
#define MEMP_NUM_SYS_TIMEOUT (LWIP_NUM_SYS_TIMEOUT_INTERNAL + 8)
// END: The following is needed to test mDns

// Create dynamic headers based on the files extension
#define LWIP_HTTPD_DYNAMIC_HEADERS 1
// THis file will be generated and located in the web servers module
#define HTTPD_FSDATA_FILE "@CMAKE_CURRENT_SOURCE_DIR@/../lib/webserver/gatas_fsdata.c"

// Default gateway to 192.168.1.1 instead of 192.168.4.1
#define CYW43_DEFAULT_IP_AP_ADDRESS LWIP_MAKEU32(192, 168, 1, 1)
#define CYW43_DEFAULT_IP_AP_GATEWAY LWIP_MAKEU32(0, 0, 0, 0)
#define CYW43_DEFAULT_IP_STA_ADDRESS LWIP_MAKEU32(192, 168, 1, 1)
#define CYW43_DEFAULT_IP_STA_GATEWAY LWIP_MAKEU32(192, 168, 1, 1)
#define CYW43_DEFAULT_IP_DNS LWIP_MAKEU32(0, 0, 0, 0)
// #define PICO_CYW43_ARCH_DEFAULT_COUNTRY_CODE CYW43_COUNTRY_USA
#define PICO_CYW43_ARCH_DEFAULT_COUNTRY_CODE CYW43_COUNTRY_WORLDWIDE
#define CYW43_HOST_NAME "GATAS"

// https://github.com/georgerobotics/cyw43-driver/issues/111
// TODO: Problem was we where getting a STALL from the CYW43 Not sure yet if this works..
#define CYW43_SDPCM_SEND_COMMON_WAIT cyw43_await_background_or_timeout_us(1750);

// https://github.com/raspberrypi/pico-sdk/issues/1443
#define PICO_MAX_SHARED_IRQ_HANDLERS 6
// Allow setting dynamic cw43 clock division because we set custom clock speeds
// 13 Jun 2026, this might not work as expected on the RP2350 while ir worked on teh RP2040
// #define CYW43_PIO_CLOCK_DIV_DYNAMIC 1
#define PICO_USE_FASTEST_SUPPORTED_CLOCK 1

// START: ***** Debugging PICO items
// https://github.com/raspberrypi/pico-sdk/blob/master/src/boards/include/boards/pico_w.h
#ifndef NDEBUG
#define PICO_DEBUG_MALLOC ( 1 )
#define PICO_CYW43_ARCH_DEBUG_ENABLED ( 1 )
#define PICO_ENTER_USB_BOOT_ON_EXIT ( 1 )
#define ETL_VERBOSE_ERRORS ( 1 )
#define ETL_LOG_ERRORS ( 1 )
#define ETL_DEBUG ( 1 )
#define ETL_CHECK_PUSH_POP ( 1)
#define GATAS_LWIP_DEBUG ( 0 )
#define GATAS_FREERTOS_DEBUG ( 1 )
